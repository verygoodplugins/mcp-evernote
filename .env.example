# Evernote API Credentials
EVERNOTE_CONSUMER_KEY=your-consumer-key
EVERNOTE_CONSUMER_SECRET=your-consumer-secret

# Environment Settings
# Set to 'sandbox' for testing or 'production' for live environment
EVERNOTE_ENVIRONMENT=production

# OAuth Settings
# Port for OAuth callback server (default: 3000)
OAUTH_CALLBACK_PORT=3000

# Optional: MCP Memory Service Integration
# Uncomment to enable sync with MCP memory service
# MCP_MEMORY_SERVICE_URL=http://localhost:8765

# Optional: Destructive operations (default: off)
# When true, advertises and allows evernote_delete_note (trash/restore) and
# evernote_connection action:"revoke". Leave unset for agent deployments.
# EVERNOTE_ENABLE_DESTRUCTIVE=true

# Optional: Debug Settings
# DEBUG=mcp:evernote:*